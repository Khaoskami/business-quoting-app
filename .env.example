# Postgres connection string (Railway injects this automatically via the plugin).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign sessions/cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# Public base URL of the API/auth server (your deployed domain).
BETTER_AUTH_URL=https://your-app.up.railway.app

# Public base URL of the client SPA (used for CORS + Stripe redirects).
CLIENT_URL=https://your-app.up.railway.app

# Stripe secret API key (sk_live_... in production, sk_test_... in dev).
STRIPE_SECRET_KEY=sk_live_...

# Stripe webhook signing secret for the /api/billing/webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price ID for the Pro tier.
STRIPE_PRO_PRICE_ID=price_...

# Stripe Price ID for the Business tier.
STRIPE_BUSINESS_PRICE_ID=price_...

# Resend API key for transactional email (password resets). https://resend.com
RESEND_API_KEY=re_...

# Sender address for password-reset emails. Must be a verified Resend domain.
RESET_FROM_EMAIL=no-reply@your-domain.com

# Admin account email. Promote it with: bun run scripts/make-admin.ts <email>
ADMIN_EMAIL=your@email.com

# Port the server listens on (defaults to 3000 if unset).
PORT=3000
