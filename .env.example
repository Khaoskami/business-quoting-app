# Postgres connection string (Railway injects this automatically via the plugin).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Authentication email verification. Keep true in production. Set false only for local development if needed.
REQUIRE_EMAIL_VERIFICATION=true

# Secret used to sign sessions/cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# Public base URL of the API/auth server (your deployed domain).
BETTER_AUTH_URL=https://your-app.up.railway.app

# Public base URL of the client SPA (used for CORS + PayFast redirects).
CLIENT_URL=https://your-app.up.railway.app

# PayFast merchant ID and key (sandbox defaults shown).
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a

# REQUIRED for recurring billing; must match the value on your PayFast account.
PAYFAST_PASSPHRASE=your-payfast-passphrase

# 'false' in production to hit live PayFast endpoints.
PAYFAST_SANDBOX=true

# Transactional email via Gmail SMTP. Create a Google App Password for SMTP_PASSWORD.
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourbusiness@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
# Sender address. For Gmail, use the same address as SMTP_USER.
EMAIL_FROM=Business Quotes <yourbusiness@gmail.com>
# Backward-compatible sender variable; EMAIL_FROM takes precedence.
RESET_FROM_EMAIL=yourbusiness@gmail.com

# Admin account email. Promote it with: bun run scripts/make-admin.ts <email>
ADMIN_EMAIL=your@email.com

# Port the server listens on (defaults to 3000 if unset).
PORT=3000

# Server-side PDF generation. Railway's production image installs Chromium.
CHROMIUM_PATH=/usr/bin/chromium
PDF_CONCURRENCY=2
