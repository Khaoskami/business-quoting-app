# ==============================
# Railway / Business Quotes
# ==============================
# Railway injects DATABASE_URL automatically when PostgreSQL is connected.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Authentication
REQUIRE_EMAIL_VERIFICATION=true
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# URLs
# On Railway these can be omitted if RAILWAY_PUBLIC_DOMAIN is available;
# the application automatically uses https://$RAILWAY_PUBLIC_DOMAIN.
BETTER_AUTH_URL=https://your-real-domain.com
CLIENT_URL=https://your-real-domain.com

# Gmail SMTP
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourbusiness@gmail.com
SMTP_PASSWORD=your-google-app-password
EMAIL_FROM=Business Quotes <yourbusiness@gmail.com>
RESET_FROM_EMAIL=yourbusiness@gmail.com

# PayFast
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=your-payfast-passphrase
PAYFAST_SANDBOX=true

# Admin
ADMIN_EMAIL=your@email.com

# Server
PORT=3000
CHROMIUM_PATH=/usr/bin/chromium
PDF_CONCURRENCY=2
