# Postgres connection string (Railway injects this automatically via the plugin).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign sessions/cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# Public base URL of the API/auth server (your deployed domain).
BETTER_AUTH_URL=https://your-app.up.railway.app

# Public base URL of the client SPA (used for CORS + PayFast redirects).
CLIENT_URL=https://your-app.up.railway.app

# PayFast merchant ID and key (sandbox defaults shown).
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a

# REQUIRED for recurring billing; must match the value on your PayFast account.
PAYFAST_PASSPHRASE=your-payfast-passphrase

# 'false' in production to hit live PayFast endpoints.
PAYFAST_SANDBOX=true

# Resend API key for transactional email (password resets). https://resend.com
RESEND_API_KEY=re_...

# Sender address for verification, password-reset, quote, and invoice emails. Must be a verified Resend domain.
RESET_FROM_EMAIL=no-reply@your-domain.com

# Admin account email. Promote it with: bun run scripts/make-admin.ts <email>
ADMIN_EMAIL=your@email.com

# Port the server listens on (defaults to 3000 if unset).
PORT=3000

# Server-side PDF generation. Railway's production image installs Chromium.
CHROMIUM_PATH=/usr/bin/chromium
PDF_CONCURRENCY=2
